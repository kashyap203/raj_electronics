PORT=5001
MONGODB_URI=mongodb://localhost:27017/raj-electronics
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
NODE_ENV=development

# Application URLs
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Email Notification Settings (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
FROM_EMAIL="Raj Electronics" <orders@rajelectronics.com>

# SMS Notification Settings (Twilio Provider)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Razorpay (legacy — not active payment gateway)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ICICI Bank Orange Payment Gateway (secondary / legacy direct gateway)
ICICI_ENV=uat
ICICI_ENVIRONMENT=uat
ICICI_MERCHANT_ID=
ICICI_HASH_KEY=
ICICI_AGGREGATOR_ID=
ICICI_SALE_URL=https://pgpayuat.icicibank.com/tsp/pg/api/v2/initiateSale
ICICI_COMMAND_URL=https://pgpayuat.icicibank.com/tsp/pg/api/command
ICICI_QR_URL=https://pgpayuat.icicibank.com/tsp/pg/api/generateQR

# Pine Labs Online Payment Gateway (ACTIVE)
PINE_LABS_ENV=uat
PINE_LABS_MID=
PINE_LABS_CLIENT_ID=
PINE_LABS_CLIENT_SECRET=
PINE_LABS_SIGNATURE_KEY=
PINE_LABS_RETURN_URL=http://localhost:5001/api/payment/pinelabs/return
PINE_LABS_WEBHOOK_URL=http://localhost:5001/api/payment/pinelabs/webhook
# For local UAT: Pine Labs blocks localhost callbacks. Use ngrok and set:
# PINE_LABS_PUBLIC_URL=https://your-subdomain.ngrok-free.app

# Pine Labs UPI UAT Simulator Test Amounts (in paisa)
UPI_SUCCESS_TEST_AMOUNT=10000
UPI_PENDING_TEST_AMOUNT=55000
UPI_FAILED_TEST_AMOUNT=65000
UPI_ERROR_TEST_AMOUNT=75000
UPI_TIMEOUT_TEST_AMOUNT=85000
